# --- Required -------------------------------------------------------------
# Password for the single authorised user. Generate with:
#   openssl rand -base64 24
APP_PASSWORD=
# Secret used to sign the session cookie. Generate with:
#   openssl rand -base64 48
SESSION_SECRET=

# GitHub credential used server-side only. Never exposed to the browser.
# Least privilege: read the repositories you want to manage.
# A GitHub App installation token or a fine-grained PAT with read access
# to Repository metadata, Contents, Issues, Pull requests, Actions,
# and Projects (read) is sufficient. Set only what the features need.
GITHUB_TOKEN=

# --- Optional ------------------------------------------------------------
# Postgres connection string (Supabase pooler or any Postgres 14+).
# Leave unset to run in "database not configured" mode: the dashboard still
# works from GitHub's live API, but history, notifications and audit are off.
DATABASE_URL=

# Displayed on the health page so the user knows what they are connected to.
GITHUB_LOGIN=

# Base URL of the deployment, used for building absolute links in reports.
NEXT_PUBLIC_APP_URL=http://localhost:3100
