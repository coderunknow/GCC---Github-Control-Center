# --- Next.js application (app/) ------------------------------------------
# Required. Without these the app fails closed: every request is treated as
# unauthenticated rather than "auth disabled".
#   openssl rand -base64 24
APP_PASSWORD=
#   openssl rand -base64 48
SESSION_SECRET=

# GitHub credential, read server-side only. Never sent to the browser and never
# placed in a URL. Least privilege: read access to the repositories you want to
# see. A fine-grained PAT needs Repository metadata, Contents, Issues, Pull
# requests, Actions (read) and, for the notifications screen, Notifications.
GITHUB_TOKEN=

# Optional. Postgres 14+ connection string. Leave unset to run without a
# database: every GitHub screen still works, while export history and the audit
# log report themselves as disabled instead of pretending to persist.
DATABASE_URL=

# Optional. Shown on the health page so you know which deployment you are on.
NEXT_PUBLIC_APP_URL=http://localhost:3100

# --- Arena host (host/server.mjs, dev1) ----------------------------------
# Used only by `node host/server.mjs`; not read by the Next.js app.
# The host refuses to start if any of these is missing or too short.
AGENT_TOKEN=
PORT=4000
HOST_DATA_FILE=host/data/state.json
# How long a worker lease stays valid before its request is reclaimed.
LEASE_TTL_MS=300000

# --- Not implemented ------------------------------------------------------
# There is no GITHUB_WEBHOOK_SECRET on purpose. This build makes outbound
# GitHub API calls only and exposes no webhook endpoint, so there is no
# signature to verify. Adding the variable without the endpoint would suggest a
# guarantee that does not exist.
